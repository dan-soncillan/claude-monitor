# ClaudeMonitor Configuration

# Server
PORT=4001
DB_PATH=claude-monitor.db

# Hooks (set in shell environment where Claude Code runs)
CLAUDE_MONITOR_URL=http://localhost:4001

# Slack Bot (optional - only needed for Slack integration)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C...

# Monitor API URL (used by Slack bot to reach the backend)
MONITOR_API_URL=http://localhost:4001
MONITOR_WS_URL=ws://localhost:4001/ws